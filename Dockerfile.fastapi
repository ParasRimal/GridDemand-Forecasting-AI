FROM python:3.12-slim

WORKDIR /app

# Install only what's needed for the ML service, not the whole requirements.txt
# (which includes Django, jupyterlab, etc. -- much heavier than FastAPI needs).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ml_service/ ./ml_service/
COPY data/ ./data/
COPY models/ ./models/

EXPOSE 8000

CMD ["uvicorn", "ml_service.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
